# SUPABASE CREDENTIALS FOR PT GAGACLO FPP
# Dapatkan kredensial ini di: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-new-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-new-supabase-anon-key

# Server-only Cloudflare R2 credentials (never use NEXT_PUBLIC_ prefix)
